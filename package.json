{
  "name": "catmos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "predev": "bash scripts/generate-brand.sh",
    "prebuild": "bash scripts/generate-brand.sh",
    "brand:gen": "bash scripts/generate-brand.sh",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "check:rust": "cd src-tauri && cargo check",
    "check:android": "bash ./scripts/check-android.sh",
    "check:linux": "cd src-tauri && cargo check --target x86_64-unknown-linux-gnu",
    "check:windows": "cd src-tauri && cargo check --target x86_64-pc-windows-msvc",
    "build:wasm": "bash ../catbird-mls-web/build.sh",
    "build:wasm:dev": "bash ../catbird-mls-web/build-dev.sh"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^25.2.2",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-deep-link": "^2.4.7",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "comlink": "^4.4.2"
  }
}
